# Copy to .env; do not commit real values. Existing environment variables take precedence.
CHECKER_URL=https://checker.example.com/check
CHECKER_TOKEN=
# Optional Cloudflare Access service token for the Checker only.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
EDGETUNNEL_HOST=edge.example.com
VLESS_UUID=
VPN_USERNAME=vpn
VPN_PASSWORD=vpn
# Optional independent intelligence provider. URL must return JSON with the queried IP.
# Example: https://iplocate.io/api/lookup/{ip}
INTELLIGENCE_URL_TEMPLATE=
INTELLIGENCE_TOKEN=
XRAY_BIN=tools/bin/xray
